# ===== Launchpad environment =====
# Anthropic API key (console.anthropic.com) - powers the chat interview + config generation
ANTHROPIC_API_KEY=

# --- Growth Lab GHL (used for DIRECT SMB deployments into YOUR agency account) ---
# Agency-level Private Integration token (Settings > Private Integrations, agency view)
# Scopes needed: locations write, custom values write, snapshots read
GHL_AGENCY_TOKEN=
# Your agency Company ID (Settings > Company > Company ID / relationship number)
GHL_COMPANY_ID=
# The Lab HQ snapshot ID to clone for new deployments
GHL_SNAPSHOT_ID=

# --- On Brand Marketing GHL (tenant: obm) ---
# Leave blank until OBM sends credentials; deploys for this tenant run in DEMO MODE until set.
OBM_GHL_TOKEN=
OBM_GHL_COMPANY_ID=
OBM_GHL_SNAPSHOT_ID=

# --- GHL Marketplace OAuth apps (two private apps, shared across all tenants) ---
# Agency app "Launchpad Agency" - creates sub-accounts. Scopes: locations
# read/write, snapshots readonly, companies readonly.
GHL_AGENCY_APP_CLIENT_ID=
GHL_AGENCY_APP_CLIENT_SECRET=
# The "Install" link copy/pasted from the app's Marketplace listing page.
GHL_AGENCY_APP_INSTALL_URL=

# Location app "Launchpad Sync" - all sub-account data writes. Scopes:
# customValues read/write, customFields read/write, contacts read/write,
# forms readonly, plus conversations read/write + conversations/message
# read/write (for the AI conversation bot - see DEPLOY.md "Conversation
# bot"). Locations authorised before the conversations scopes were added
# need re-authorising ("Authorise data sync") before the bot can read/send.
GHL_LOCATION_APP_CLIENT_ID=
GHL_LOCATION_APP_CLIENT_SECRET=
GHL_LOCATION_APP_INSTALL_URL=

# 32+ char random string used to encrypt stored OAuth connections at rest
# (Netlify Blobs store "ghl-connections"). Generate with:
#   openssl rand -base64 32
LAUNCHPAD_MASTER_KEY=

# --- Mission Control (deployment log dashboard at /<tenant>/missioncontrol) ---
# Optional. Each tenant sets their own dashboard password on first visit
# (stored hashed in Netlify Blobs) - nothing to configure here for that.
# Only set this if you want a master override that works for every tenant,
# e.g. to recover access if a tenant forgets their password.
MC_PASSWORD=

# --- Self-serve Agency Portal (/portal) ---
# Invite codes (generated in /admin) are the only LIVE activation path.
# Stripe stays inert until these are set - ask the operator for real values,
# never write them into this file. Card payment on the Activate step simply
# reports "not set up yet" until then.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_FOUNDING=

# Optional. GHL agency-side share link for the Lab HQ snapshot, shown with a
# copy button on the portal onboarding wizard's "Import the snapshot" step.
LABHQ_SNAPSHOT_SHARE_URL=

# --- Miia checkout (meetmiia.com) ---
# A separate, dedicated Stripe account - NOT the same as STRIPE_SECRET_KEY
# above. Stays inert (503 on /api/miia/checkout and /api/miia/webhook) until
# set - ask the operator for real values, never write them into this file.
MIIA_STRIPE_SECRET_KEY=
MIIA_STRIPE_WEBHOOK_SECRET=

# true while founding pricing is active: checkout uses the *_FOUNDING price
# ids below for monthly plans, and pricing/get-started show the founding
# price with the standard price struck through. Yearly always uses the
# standard yearly price regardless of this flag (there's no founding-yearly
# price). Flip to false when founding pricing ends.
MIIA_FOUNDING_MODE=

# Standard prices
MIIA_STRIPE_PRICE_CHAT_MONTHLY=
MIIA_STRIPE_PRICE_EVERYWHERE_MONTHLY=
MIIA_STRIPE_PRICE_EVERYWHERE_YEARLY=
MIIA_STRIPE_PRICE_EVERYTHING_MONTHLY=
MIIA_STRIPE_PRICE_EVERYTHING_YEARLY=
MIIA_STRIPE_PRICE_WHITEGLOVE_ONCE=

# Founding prices (flat, monthly only)
MIIA_STRIPE_PRICE_CHAT_FOUNDING=
MIIA_STRIPE_PRICE_EVERYWHERE_FOUNDING=
MIIA_STRIPE_PRICE_EVERYTHING_FOUNDING=

# Optional. Where the "provisioning failed after payment" alert goes.
# Defaults to hello@growthlabco.com.au if unset.
MIIA_OPS_ALERT_EMAIL=

# --- Team invite emails (Mission Control > Settings > Team) ---
# Optional. Without this, invites still save for real - the operator just
# gets an honest "email didn't send" toast instead of the invite going out.
# Get a key at resend.com; the default from-address is Resend's shared
# sandbox sender (onboarding@resend.dev), which works without verifying a
# domain. Set RESEND_FROM_EMAIL once you verify labhq.co (or your own
# domain) in Resend to send from your own address instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Auto-register tenant subdomains as Netlify domain aliases ---
# Optional. Without this, new tenants still work fine at labhq.co/{slug} -
# they just don't get {slug}.labhq.co auto-claimed on the Netlify site, and
# show up flagged for retry in /admin. Personal access token from
# app.netlify.com/user/applications (needs access to this site's team).
# SITE_ID is provided automatically by Netlify at runtime - nothing to set.
NETLIFY_API_TOKEN=
