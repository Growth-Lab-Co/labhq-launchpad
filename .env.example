# ===== Launchpad environment =====
# Anthropic API key (console.anthropic.com) - powers the chat interview + config generation
ANTHROPIC_API_KEY=

# --- Growth Lab GHL (used for DIRECT SMB deployments into YOUR agency account) ---
# Agency-level Private Integration token (Settings > Private Integrations, agency view)
# Scopes needed: locations write, custom values write, snapshots read
GHL_AGENCY_TOKEN=
# Your agency Company ID (Settings > Company > Company ID / relationship number)
GHL_COMPANY_ID=
# The Lab HQ snapshot ID to clone for new deployments
GHL_SNAPSHOT_ID=

# --- On Brand Marketing GHL (tenant: obm) ---
# Leave blank until OBM sends credentials; deploys for this tenant run in DEMO MODE until set.
OBM_GHL_TOKEN=
OBM_GHL_COMPANY_ID=
OBM_GHL_SNAPSHOT_ID=
